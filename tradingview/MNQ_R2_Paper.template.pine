//@version=6
// Generated release: MNQ_R2_Paper.pine. Edit this template, then run scripts/build_tradingview.py.
// Strategy Tester simulation only. Chart bars cannot establish broker execution quality.
strategy("MNQ R2 Paper Research", overlay = true, initial_capital = 25000, currency = currency.USD, default_qty_type = strategy.fixed, default_qty_value = 2, pyramiding = 0, commission_type = strategy.commission.cash_per_contract, commission_value = 0.75, slippage = 1, margin_long = 1, margin_short = 1, calc_on_every_tick = true, calc_on_order_fills = false, process_orders_on_close = false, max_bars_back = 500)

const string TZ = "America/New_York"
const float TICK = 0.25
const float POINT = 2.0
const int MINUTE = 60000
const string AUDIT_VERSION = "R2_TV_GUARDS_V1"
stage = input.string("Funded", "Account stage", options = ["Funded", "Evaluation"], group = "Account")
lossBudget = input.float(100, "Session loss budget ($)", minval = 1, group = "Account")
evalTarget = input.float(750, "Evaluation session profit target ($)", minval = 1, group = "Account")
paperStart = input.time(timestamp("07 Oct 2026 00:00 -0400"), "Paper experiment start (ET)", group = "Account")
feedLabel = input.string("Delayed research", "Chart data entitlement (label only)", options = ["Delayed research", "Real-time research"], group = "Account")
startQty = input.int(2, "Starting MNQ contracts", minval = 1, maxval = 10, group = "Sizing")
maxQty = input.int(10, "Maximum MNQ contracts", minval = 1, maxval = 10, group = "Sizing")
studyMode = input.string("Baseline R2", "Paper test variant", options = ["Baseline R2", "Trade risk cap only", "Cash open guard only", "Guarded R2"], group = "Paper experiment")
tradeCap = input.float(25, "Maximum planned loss per new position ($)", minval = 1, group = "Paper experiment")
openBefore = input.int(5, "Cash-open buffer before (minutes)", minval = 0, maxval = 30, group = "Paper experiment")
openAfter = input.int(10, "Cash-open buffer after (minutes)", minval = 0, maxval = 30, group = "Paper experiment")
bool capEnabled = studyMode == "Trade risk cap only" or studyMode == "Guarded R2"
bool openGuardEnabled = studyMode == "Cash open guard only" or studyMode == "Guarded R2"
adaptiveSize = input.bool(true, "Adaptive paper sizing", group = "Sizing")
adaptiveQuality = input.bool(true, "Learn quality from completed trades", group = "Sizing")
feesRT = input.float(1.50, "Round-trip fees per contract ($): match Properties", minval = 0, group = "Execution model")
exitSlip = input.int(1, "Exit slippage ticks: match Properties", minval = 0, group = "Execution model")
chaseTicks = input.int(4, "Entry limit distance (ticks)", minval = 0, maxval = 20, group = "Execution model")
feesVerified = input.bool(false, "Fees verified against actual account", group = "Execution model")
useBE = input.bool(true, "Use cost-aware break-even", group = "Execution model")
beTrigger = input.float(1, "Break-even trigger (initial R)", minval = 0.5, group = "Execution model")
reviewVisible = input.bool(true, "Show loss review", group = "Dashboard")
reviewPage = input.int(1, "Loss review page (1–3)", minval = 1, maxval = 3, group = "Dashboard")
reviewBack = input.int(1, "Loss to review (1 = newest, up to 20)", minval = 1, maxval = 20, group = "Dashboard")
lossLogs = input.bool(true, "Write 30 answers to Pine Logs on each loss", group = "Dashboard")
auditLogs = input.bool(true, "Write entry plans and every completed trade to Pine Logs", group = "Dashboard")

// @GENERATED_CALENDAR@

// @HELPERS_BEGIN@
f_futures_day(int ts) =>
    timestamp(TZ, year(ts, TZ), month(ts, TZ), dayofmonth(ts, TZ) + (hour(ts, TZ) >= 18 ? 1 : 0), 0, 0)

f_round_stop(float price, int direction) =>
    direction > 0 ? math.floor(price / TICK) * TICK : math.ceil(price / TICK) * TICK

f_fit(int suggested, float reservation, float remaining) =>
    int quantity = reservation > 0 ? math.min(suggested, math.max(0, int(math.floor(remaining / reservation)))) : 0
    while quantity > 0 and quantity * reservation > remaining
        quantity -= 1
    quantity

f_allowance(float sessionBudget, float sessionResult, bool capped, float perTradeCap) =>
    float remaining = math.max(0, sessionBudget + math.min(0, sessionResult))
    capped ? math.min(remaining, perTradeCap) : remaining

f_overlap(int start, int finish, int guardStart, int guardEnd) =>
    start < guardEnd and finish > guardStart

f_window_stats(array<float> recent) =>
    float net = 0
    float positive = 0
    float negative = 0
    float equity = 0
    float peak = 0
    float dd = 0
    float largest = 0
    int wins = 0
    if array.size(recent) > 0
        for value in recent
            net += value
            positive += math.max(0, value)
            negative += math.max(0, -value)
            equity += value
            peak := math.max(peak, equity)
            dd := math.max(dd, peak - equity)
            largest := math.max(largest, value)
            wins += value > 0 ? 1 : 0
    bool qualifies = array.size(recent) == 20 and net >= 4 and (negative == 0 or positive >= 1.5 * negative) and wins >= 8 and net - largest > 0 and dd < 3
    [net, dd, qualifies]

f_size_step(array<float> recent, int quantity, int count, int streak, int sinceReduction, bool weakLatched, float value, bool eligible, int maximum) =>
    int q = quantity
    int n = count
    int ls = streak
    int since = sinceReduction
    bool weak = weakLatched
    string reason = "FAULT_REDUCTION"
    if not eligible
        q := math.max(1, int(math.floor(q / 2)))
        ls := 0
        since := 0
    else
        n += 1
        since += 1
        array.push(recent, value)
        if array.size(recent) > 20
            array.shift(recent)
        ls := value < 0 ? ls + 1 : 0
        reason := n < 20 ? "BUILDING_RECORD" : "HOLD_SIZE"
        if ls >= 2
            q := math.max(1, ls == 2 ? int(math.floor(q / 2)) : q - 1)
            since := 0
            reason := "LOSS_STREAK_REDUCTION"
        [net, dd, qualifies] = f_window_stats(recent)
        bool nowWeak = array.size(recent) == 20 and (net <= 0 or dd >= 3)
        if nowWeak and not weak
            q := math.max(1, int(math.floor(q / 2)))
            since := 0
            reason := "WEAK_WINDOW_REDUCTION"
        weak := nowWeak
        if n % 20 == 0 and qualifies and value > 0 and since >= 5
            reason := q < maximum ? "PROFITABLE_BLOCK_INCREASE" : "AT_MAXIMUM"
            q := math.min(maximum, q + 1)
    [q, n, ls, since, weak, reason]

f_quality(array<float> outcomes, float base, bool enabledQuality) =>
    enabledQuality and array.size(outcomes) == 8 and array.sum(outcomes) <= 0 ? math.min(0.90, base + 0.15) : base

f_runner(int direction, float fill, float risk, float peak, float stop, float executable) =>
    float proposed = f_round_stop(peak - direction * risk, direction)
    direction * (peak - fill) >= 1.5 * risk and direction * (proposed - stop) >= TICK and direction * (executable - proposed) > TICK ? proposed : stop

f_setup(float atr, float minimumEfficiency, float maxStopAtr) =>
    float change = close - open[5]
    float path = math.abs(close[5] - open[5])
    bool contiguous = bar_index >= 5
    for i = 0 to 4
        path += math.abs(close[i] - close[i + 1])
        contiguous := contiguous and time[i] == time_close[i + 1]
    float momentum = atr > 0 ? change / atr : 0
    int direction = momentum >= 0.05 ? 1 : momentum <= -0.05 ? -1 : 0
    float efficiency = path > 0 ? math.abs(change) / path : 0
    float width = high - low
    float stop = direction > 0 ? low[1] - TICK : high[1] + TICK
    float risk = direction * (close - stop)
    bool breakout = direction > 0 ? close > math.max(high[2], high[1]) and (close - low) / width >= 0.70 : close < math.min(low[2], low[1]) and (high - close) / width >= 0.70
    bool valid = contiguous and atr > 0 and direction != 0 and efficiency >= minimumEfficiency and width > 0 and width <= 0.25 * atr and direction * (close[1] - open[1]) < 0 and breakout and risk > 0 and risk <= maxStopAtr * atr
    [valid ? direction : 0, f_round_stop(stop, direction), efficiency, momentum]
// @HELPERS_END@

// ATR is calculated from 26 complete fifteen-minute cash bars per reviewed day.
// This preserves cash highs/lows/closing price, but cannot prove intra-bar tick coverage.
f_cash_atr() =>
    var array<float> ranges = array.new<float>()
    var int activeRow = -1
    var int completedRow = -1
    var float previousClose = na
    var float cashHigh = na
    var float cashLow = na
    var int count = 0
    var int lastEnd = na
    int dayKey = timestamp(TZ, year(time, TZ), month(time, TZ), dayofmonth(time, TZ), 0, 0)
    int row = array.indexof(calDay, dayKey)
    if row >= 0
        int start = array.get(cashOpen, row)
        int finish = array.get(cashClose, row)
        if time >= start and time_close <= finish
            if row != activeRow
                activeRow := row
                count := 0
                cashHigh := high
                cashLow := low
                lastEnd := na
                if time != start or (completedRow >= 0 and row != completedRow + 1)
                    array.clear(ranges)
                    previousClose := na
            bool sequential = count == 0 ? time == start : time == lastEnd
            if not sequential
                array.clear(ranges)
                previousClose := na
                count := -1000
            cashHigh := math.max(cashHigh, high)
            cashLow := math.min(cashLow, low)
            count += 1
            lastEnd := time_close
            if time_close == finish
                if count == 26 and finish - start == 390 * MINUTE
                    float tr = na(previousClose) ? na : math.max(cashHigh - cashLow, math.max(math.abs(cashHigh - previousClose), math.abs(cashLow - previousClose)))
                    if not na(tr)
                        array.push(ranges, tr)
                        if array.size(ranges) > 21
                            array.shift(ranges)
                    previousClose := close
                    completedRow := row
                else
                    array.clear(ranges)
                    previousClose := na
    float latest = na
    float lagged = na
    int n = array.size(ranges)
    if n >= 20
        float sum = 0
        for i = n - 20 to n - 1
            sum += array.get(ranges, i)
        latest := sum / 20
    if n >= 21
        float sum = 0
        for i = n - 21 to n - 2
            sum += array.get(ranges, i)
        lagged := sum / 20
    [latest, lagged, completedRow, n]

[cashAtr, priorCashAtr, atrRow, atrCount] = request.security(syminfo.tickerid, "15", f_cash_atr(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = 5000)
int riskDay = f_futures_day(time)
int row = array.indexof(calDay, riskDay)
float atr = na
if row >= 0 and atrRow >= 0 and (atrRow == row - 1 or atrRow == row)
    atr := atrRow == row ? priorCashAtr : cashAtr
bool cashRegime = hour(time_close, TZ) * 60 + minute(time_close, TZ) >= 570 and hour(time_close, TZ) * 60 + minute(time_close, TZ) < 960
int profile = cashRegime ? 0 : 1
bool symbolOK = syminfo.root == "MNQ" and syminfo.ticker == "MNQZ2026" and math.abs(syminfo.mintick - TICK) < 0.000001 and math.abs(syminfo.pointvalue - POINT) < 0.000001
bool chartOK = timeframe.isminutes and timeframe.multiplier == 5 and chart.is_standard
bool inputsOK = startQty <= maxQty
bool marketAllowed = false
bool newsPause = false
bool openPause = false
bool openEntryPause = false
int flattenAt = na
int enterUntil = na
if row >= 0
    int start = array.get(marketOpen, row)
    int finish = array.get(marketClose, row)
    marketAllowed := array.get(enabled, row) and time_close >= start + 30 * MINUTE and time_close <= finish - 15 * MINUTE
    flattenAt := finish - 5 * MINUTE
    enterUntil := finish - 15 * MINUTE
    if array.size(breakStart) > 0
        for i = 0 to array.size(breakStart) - 1
            int a = array.get(breakStart, i)
            int b = array.get(breakEnd, i)
            if b > time_close and a >= start and a <= finish
                flattenAt := math.min(flattenAt, a - 5 * MINUTE)
                enterUntil := math.min(enterUntil, a - 5 * MINUTE)
            if time_close >= a and time_close < b
                marketAllowed := false
    marketAllowed := marketAllowed and time_close <= enterUntil
    if openGuardEnabled
        int opening = array.get(cashOpen, row)
        int guardStart = opening - openBefore * MINUTE
        int guardEnd = opening + openAfter * MINUTE
        // Flatten at the first confirmed close reaching the buffer start.
        openPause := guardStart < guardEnd and time_close >= guardStart and time < guardEnd
        // A pending entry lasts through the next bar: avoid any overlapping fill window.
        openEntryPause := guardStart < guardEnd and f_overlap(time, time_close + 5 * MINUTE, guardStart, guardEnd)
for i = 0 to array.size(newsStart) - 1
    // Block bars overlapping a news pause and entries whose next fill bar would cross it.
    int a = array.get(newsStart, i)
    int b = array.get(newsEnd, i)
    newsPause := newsPause or (time < b and time_close + 5 * MINUTE > a)

var array<float> daySizes = array.new<float>()
var array<float> nightSizes = array.new<float>()
var array<int> sizeQ = array.from(startQty, startQty)
var array<int> sizeCount = array.from(0, 0)
var array<int> sizeStreak = array.from(0, 0)
var array<int> sizeSince = array.from(20, 20)
var array<bool> sizeWeak = array.from(false, false)
var array<string> sizeReason = array.from("BUILDING_RECORD", "BUILDING_RECORD")
var array<float> dayLong = array.new<float>()
var array<float> dayShort = array.new<float>()
var array<float> nightLong = array.new<float>()
var array<float> nightShort = array.new<float>()
var array<string> reviews = array.new<string>()
var array<string> lossHeaders = array.new<string>()
var int processedClosed = 0
var int lastExitBar = -1
var int activeRiskDay = na
var float sessionNet = 0
var bool sessionLocked = false
var int pendingBar = na
var int positionProfile = 0
var int positionDirection = 0
var int plannedQty = 0
var float reference = na
var float initialStop = na
var float activeStop = na
var float entryAtr = na
var float entryEfficiency = na
var float entryThreshold = na
var float entryReservation = na
var float entryAllowance = na
var int entryRiskDay = na
var int entryPlanTime = na
var float positionRisk = na
var float peakPrice = na
var bool breakEvenArmed = false
var string decision = "WAITING_FOR_BAR"
var int riskRejects = 0
var int openGuardBars = 0
var string lastAudit = "No completed positions"
var int loadedFirstTime = time

array<float> qualityLong = profile == 0 ? dayLong : nightLong
array<float> qualityShort = profile == 0 ? dayShort : nightShort
float baseEfficiency = cashRegime ? 0.40 : 0.55
float longEfficiency = f_quality(qualityLong, baseEfficiency, adaptiveQuality)
float shortEfficiency = f_quality(qualityShort, baseEfficiency, adaptiveQuality)
float change = close - open[5]
float minEfficiency = change >= 0 ? longEfficiency : shortEfficiency
[signal, signalStop, setupEfficiency, setupMomentum] = f_setup(atr, minEfficiency, cashRegime ? 0.20 : 0.10)

if barstate.isconfirmed
    if openEntryPause and time_close >= paperStart
        openGuardBars += 1
    if na(activeRiskDay) or riskDay != activeRiskDay
        activeRiskDay := riskDay
        sessionNet := 0
        sessionLocked := strategy.position_size != 0 or not na(pendingBar)
    if strategy.closedtrades > processedClosed
        for trade = processedClosed to strategy.closedtrades - 1
            float net = strategy.closedtrades.profit(trade)
            float quantity = math.abs(strategy.closedtrades.size(trade))
            float fill = strategy.closedtrades.entry_price(trade)
            float exitFill = strategy.closedtrades.exit_price(trade)
            float originalRisk = positionDirection * (fill - initialStop) * POINT * quantity
            float gross = positionDirection * (exitFill - fill) * POINT * quantity
            float commission = strategy.closedtrades.commission(trade)
            bool eligible = originalRisk > 0 and quantity == plannedQty and math.abs(commission - feesRT * quantity) < 0.00001 and positionDirection * (fill - reference) / TICK <= chaseTicks + 0.00001 and quantity * (originalRisk / math.max(1, quantity) + feesRT + exitSlip * TICK * POINT) <= entryReservation + 0.00001
            if f_futures_day(strategy.closedtrades.exit_time(trade)) == riskDay
                sessionNet += net
            string exitReason = strategy.closedtrades.exit_comment(trade)
            float runup = strategy.closedtrades.max_runup(trade)
            float drawdown = strategy.closedtrades.max_drawdown(trade)
            lastAudit := "#" + str.tostring(trade + 1) + " $" + str.tostring(net, "#.00") + " / " + exitReason + " / planned $" + str.tostring(entryReservation, "#.00")
            if auditLogs
                string audit = "R2_TRADE_AUDIT|variant=" + studyMode + "|trade=" + str.tostring(trade + 1) + "|profile=" + (positionProfile == 0 ? "RTH" : "OVERNIGHT") + "|entry_risk_day=" + str.format_time(entryRiskDay, "yyyy-MM-dd", TZ) + "|planned_at_et=" + str.format_time(entryPlanTime, "yyyy-MM-dd HH:mm", TZ) + "|entry_et=" + str.format_time(strategy.closedtrades.entry_time(trade), "yyyy-MM-dd HH:mm", TZ) + "|exit_et=" + str.format_time(strategy.closedtrades.exit_time(trade), "yyyy-MM-dd HH:mm", TZ) + "|direction=" + str.tostring(positionDirection) + "|quantity=" + str.tostring(quantity) + "|reference=" + str.tostring(reference, "#.00") + "|entry=" + str.tostring(fill, "#.00") + "|initial_stop=" + str.tostring(initialStop, "#.00") + "|final_stop=" + str.tostring(activeStop, "#.00") + "|exit=" + str.tostring(exitFill, "#.00") + "|atr20=" + str.tostring(entryAtr, "#.000") + "|efficiency=" + str.tostring(entryEfficiency, "#.000") + "|required_efficiency=" + str.tostring(entryThreshold, "#.000") + "|planned_risk_usd=" + str.tostring(entryReservation, "#.00") + "|allowance_usd=" + str.tostring(entryAllowance, "#.00") + "|initial_risk_usd=" + str.tostring(originalRisk, "#.00") + "|net_usd=" + str.tostring(net, "#.00") + "|commission_usd=" + str.tostring(commission, "#.00") + "|mfe_emulator_usd=" + str.tostring(runup, "#.00") + "|mae_emulator_usd=" + str.tostring(drawdown, "#.00") + "|break_even_armed=" + str.tostring(breakEvenArmed) + "|exit_reason=" + exitReason + "|learning_eligible=" + str.tostring(eligible) + "|planned_risk_exceeded=" + str.tostring(-net > entryReservation + 0.00001)
                audit += "|feed_label=" + feedLabel + "|account_stage=" + stage + "|paper_start_et=" + str.format_time(paperStart, "yyyy-MM-dd HH:mm", TZ) + "|session_loss_budget_usd=" + str.tostring(lossBudget, "#.00") + "|evaluation_target_usd=" + str.tostring(evalTarget, "#.00") + "|entry_chase_ticks=" + str.tostring(chaseTicks) + "|trade_cap_enabled=" + str.tostring(capEnabled) + "|trade_cap_usd=" + str.tostring(tradeCap, "#.00") + "|open_guard_enabled=" + str.tostring(openGuardEnabled) + "|open_buffer_before_min=" + str.tostring(openBefore) + "|open_buffer_after_min=" + str.tostring(openAfter) + "|be_enabled=" + str.tostring(useBE) + "|be_trigger_r=" + str.tostring(beTrigger, "#.00") + "|starting_contracts=" + str.tostring(startQty) + "|maximum_contracts=" + str.tostring(maxQty) + "|adaptive_sizing=" + str.tostring(adaptiveSize) + "|adaptive_quality=" + str.tostring(adaptiveQuality) + "|configured_fees_roundtrip_usd=" + str.tostring(feesRT, "#.00") + "|configured_exit_slippage_ticks=" + str.tostring(exitSlip)
                audit += "|audit_version=" + AUDIT_VERSION + "|calendar_sha256=" + calendarHash + "|symbol=" + syminfo.tickerid + "|chart_session=" + syminfo.session + "|chart_interval=" + timeframe.period + "|loaded_first_bar_et=" + str.format_time(loadedFirstTime, "yyyy-MM-dd HH:mm", TZ)
                log.info(audit)
            array<float> sizes = positionProfile == 0 ? daySizes : nightSizes
            [q, n, streak, since, weak, reason] = f_size_step(sizes, array.get(sizeQ, positionProfile), array.get(sizeCount, positionProfile), array.get(sizeStreak, positionProfile), array.get(sizeSince, positionProfile), array.get(sizeWeak, positionProfile), originalRisk > 0 ? net / originalRisk : 0, eligible, maxQty)
            array.set(sizeQ, positionProfile, q)
            array.set(sizeCount, positionProfile, n)
            array.set(sizeStreak, positionProfile, streak)
            array.set(sizeSince, positionProfile, since)
            array.set(sizeWeak, positionProfile, weak)
            array.set(sizeReason, positionProfile, reason)
            if eligible
                array<float> learning = positionProfile == 0 ? (positionDirection > 0 ? dayLong : dayShort) : (positionDirection > 0 ? nightLong : nightShort)
                array.push(learning, net)
                if array.size(learning) > 8
                    array.shift(learning)
            else
                sessionLocked := true
            if net < 0
                string header = "Loss #" + str.tostring(trade + 1) + " / " + (positionProfile == 0 ? "RTH" : "OVERNIGHT") + " / " + str.format_time(strategy.closedtrades.exit_time(trade), "yyyy-MM-dd HH:mm", TZ) + " ET / $" + str.tostring(net, "#.00")
                array.push(lossHeaders, header)
                array<string> answers = array.from("Passed entry guards; efficiency " + str.tostring(entryEfficiency, "#.000") + "/" + str.tostring(entryThreshold, "#.000"), "Six contiguous closed five-minute bars", "Prior completed cash sessions only; ATR " + str.tostring(entryAtr, "#.00"), "Reviewed calendar; candle coverage only", "Entry paused for supplied releases; completeness unknown", "Frozen MNQ December 2026; continuous contracts excluded", "Tick faults cannot be inferred from candle data", "No broker server: emulator stop", "Stop submitted with entry; intrabar path is modeled", str.tostring(quantity) + " MNQ; full planned risk reserved", "No additions to positions; pyramiding=0", "Adverse entry ticks " + str.tostring(positionDirection * (fill - reference) / TICK, "#.00"), feesVerified ? "User marked verified; charged $" + str.tostring(commission, "#.00") : "Fees provisional; charged $" + str.tostring(commission, "#.00"), "Bid/ask unobserved on 5-minute chart; spread unknown", gross >= 0 ? "Yes: costs erased nonnegative gross profit" : "No: gross price result was negative", "Entry efficiency " + str.tostring(entryEfficiency, "#.000") + "; causal chop inference unknown", "Initial stop/ATR " + str.tostring(math.abs(fill - initialStop) / entryAtr, "#.000"), "Emulator MAE $" + str.tostring(strategy.closedtrades.max_drawdown(trade), "#.00"), "Emulator MFE $" + str.tostring(strategy.closedtrades.max_runup(trade), "#.00") + "; tick path unknown", useBE ? (breakEvenArmed ? "Armed on a completed bar" : "Trigger not armed on a completed bar") : "Disabled", "Stop-to-exit adverse ticks " + str.tostring(math.max(0, positionDirection * (activeStop - exitFill) / TICK), "#.00"), strategy.closedtrades.exit_comment(trade), "One position; no repeated order on the same signal bar", "Session net $" + str.tostring(sessionNet, "#.00") + " / loss budget $" + str.tostring(lossBudget, "#.00"), stage + (stage == "Evaluation" ? "; target $" + str.tostring(evalTarget, "#.00") : "; no profit target"), "Unknown: funding-firm rules are not supplied", "Settings edits rebuild history; no manual order route", "Unknown: queue, partial fills, latency and size impact unmodeled", "Separated by side and cash/overnight; recurrence needs more sessions", "Unknown until chronological holdout and forward validation")
                for i = 0 to 29
                    string line = str.tostring(i + 1) + ". " + array.get(questions, i) + "  " + array.get(answers, i)
                    array.push(reviews, line)
                    if lossLogs
                        log.info(header + " | " + line)
                if array.size(lossHeaders) > 20
                    array.shift(lossHeaders)
                    for i = 0 to 29
                        array.shift(reviews)
        processedClosed := strategy.closedtrades
        lastExitBar := bar_index
        pendingBar := na
        positionRisk := na
        peakPrice := na
    if strategy.position_size != 0
        pendingBar := na
        if na(positionRisk)
            positionRisk := positionDirection * (strategy.position_avg_price - initialStop)
            peakPrice := strategy.position_avg_price
        // Closed-bar peak avoids letting a high/low retroactively move a stop within this bar.
        peakPrice := positionDirection > 0 ? math.max(peakPrice, close) : math.min(peakPrice, close)
        if useBE and positionRisk > 0 and positionDirection * (close - strategy.position_avg_price) >= beTrigger * positionRisk
            float costTicks = math.ceil(feesRT / (TICK * POINT) + exitSlip)
            float beStop = f_round_stop(strategy.position_avg_price + positionDirection * costTicks * TICK, positionDirection)
            if positionDirection * (beStop - activeStop) >= TICK and positionDirection * (close - beStop) > TICK
                activeStop := beStop
                breakEvenArmed := true
        if positionRisk > 0
            activeStop := f_runner(positionDirection, strategy.position_avg_price, positionRisk, peakPrice, activeStop, close)
        strategy.exit("Protect", from_entry = "R2", stop = activeStop, comment = "PROTECTIVE_STOP")
        int entryTime = strategy.opentrades.entry_time(0)
        bool timeExit = time_close >= entryTime + (positionProfile == 0 ? 90 : 45) * MINUTE
        bool closeExit = row < 0 or (not na(flattenAt) and time_close >= flattenAt)
        bool lossExit = sessionNet + strategy.openprofit - math.abs(strategy.position_size) * (feesRT / 2 + exitSlip * TICK * POINT) <= -lossBudget
        bool targetExit = stage == "Evaluation" and sessionNet + strategy.openprofit - math.abs(strategy.position_size) * (feesRT / 2 + exitSlip * TICK * POINT) >= evalTarget
        if positionRisk <= 0 or closeExit or timeExit or newsPause or openPause or lossExit or targetExit or sessionLocked
            string reason = positionRisk <= 0 ? "FILL_RISK_FAULT" : lossExit ? "SESSION_LOSS_EXIT" : targetExit ? "EVAL_TARGET_EXIT" : closeExit ? "SESSION_CLOSE_EXIT" : newsPause ? "NEWS_EXIT" : openPause ? "CASH_OPEN_BUFFER_EXIT" : sessionLocked ? "SESSION_LOCK_EXIT" : "HOLD_TIME_EXIT"
            strategy.close("R2", comment = reason, immediately = true)
            sessionLocked := sessionLocked or lossExit or targetExit or positionRisk <= 0
    if not na(pendingBar) and strategy.position_size == 0 and bar_index > pendingBar
        strategy.cancel_all()
        pendingBar := na
    sessionLocked := sessionLocked or sessionNet <= -lossBudget or (stage == "Evaluation" and sessionNet >= evalTarget)
    decision := not symbolOK ? "WRONG_CONTRACT: use MNQZ2026" : not chartOK ? "USE_STANDARD_5_MINUTE_CANDLES" : not inputsOK ? "START_SIZE_EXCEEDS_MAXIMUM" : row < 0 ? "CALENDAR_EXPIRED_OR_MISSING" : time_close < paperStart ? "BEFORE_EXPERIMENT_START" : na(atr) or atr <= 0 ? "ATR_WARMUP: 21 completed prior cash days" : sessionLocked ? "SESSION_RISK_LOCK" : strategy.position_size != 0 ? "MANAGING_POSITION" : not na(pendingBar) ? "ENTRY_PENDING" : not marketAllowed ? "OUTSIDE_REVIEWED_ENTRY_HOURS" : newsPause ? "NEWS_PAUSE" : openEntryPause ? "CASH_OPEN_BUFFER" : lastExitBar == bar_index ? "CLOSED_TRADE_COOLDOWN" : signal == 0 ? "SCANNING: NO_QUALIFYING_SETUP" : "SETUP_READY"
    if decision == "SETUP_READY"
        float limit = close + signal * chaseTicks * TICK
        float reservation = signal * (limit - signalStop) * POINT + feesRT + exitSlip * TICK * POINT
        float remaining = f_allowance(lossBudget, sessionNet, capEnabled, tradeCap)
        int suggested = adaptiveSize ? array.get(sizeQ, profile) : startQty
        int quantity = f_fit(suggested, reservation, remaining)
        if quantity > 0
            plannedQty := quantity
            positionProfile := profile
            positionDirection := signal
            reference := close
            initialStop := signalStop
            activeStop := signalStop
            entryAtr := atr
            entryEfficiency := setupEfficiency
            entryThreshold := minEfficiency
            entryReservation := quantity * reservation
            entryAllowance := remaining
            entryRiskDay := riskDay
            entryPlanTime := time_close
            positionRisk := na
            peakPrice := na
            breakEvenArmed := false
            pendingBar := bar_index
            strategy.entry("R2", signal > 0 ? strategy.long : strategy.short, qty = quantity, limit = limit, comment = cashRegime ? "RTH_PULLBACK_BREAKOUT" : "OVERNIGHT_PULLBACK_BREAKOUT")
            strategy.exit("Protect", from_entry = "R2", stop = signalStop, comment = "PROTECTIVE_STOP")
            if auditLogs
                log.info("R2_ENTRY_PLAN|variant=" + studyMode + "|planned_at_et=" + str.format_time(time_close, "yyyy-MM-dd HH:mm", TZ) + "|direction=" + str.tostring(signal) + "|quantity=" + str.tostring(quantity) + "|reference=" + str.tostring(reference, "#.00") + "|limit=" + str.tostring(limit, "#.00") + "|initial_stop=" + str.tostring(signalStop, "#.00") + "|planned_risk_usd=" + str.tostring(entryReservation, "#.00") + "|allowance_usd=" + str.tostring(remaining, "#.00"))
            decision := "ENTRY_PENDING"
        else
            riskRejects += 1
            decision := capEnabled and tradeCap < math.max(0, lossBudget + math.min(0, sessionNet)) ? "TRADE_RISK_CAP_CANNOT_FIT_ONE_CONTRACT" : "RISK_BUDGET_CANNOT_FIT_ONE_CONTRACT"

plot(strategy.position_size != 0 ? activeStop : na, "Active protective stop", color = color.orange, style = plot.style_linebr, linewidth = 2)
plot(atr, "Lagged cash ATR20", display = display.data_window)
plot(sessionNet, "Session net P&L ($)", display = display.data_window)
plot(array.get(sizeQ, 0), "RTH evidence size", display = display.data_window)
plot(array.get(sizeQ, 1), "Overnight evidence size", display = display.data_window)
plot(entryReservation, "Last submitted planned position risk ($)", display = display.data_window)
plot(entryAllowance, "Last submitted position risk allowance ($)", display = display.data_window)
plot(riskRejects, "Setups rejected by cash risk", display = display.data_window)
plot(openGuardBars, "Cash-open guard bars", display = display.data_window)
var table dashboard = table.new(position.top_right, 2, 20, bgcolor = color.new(color.rgb(12, 21, 32), 5), frame_color = color.gray, frame_width = 1)
var table lossReview = table.new(position.bottom_left, 1, 12, bgcolor = color.new(color.rgb(12, 21, 32), 5), frame_color = color.gray, frame_width = 1)
f_cell(int line, string key, string value) =>
    table.cell(dashboard, 0, line, key, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dashboard, 1, line, value, text_color = color.white, text_size = size.small, text_halign = text.align_left)
if barstate.islast
    f_cell(0, "MNQ R2", "STRATEGY TESTER SIMULATION")
    f_cell(1, "Data", feedLabel + "; entitlement not detected")
    f_cell(2, "Decision (last close)", decision)
    f_cell(3, "Chart bar / execution clock", str.format_time(time, "MM-dd HH:mm", TZ) + " / " + str.format_time(timenow, "HH:mm:ss", TZ) + " ET")
    f_cell(4, "Stage / futures day", stage + " / " + str.format_time(riskDay, "yyyy-MM-dd", TZ))
    f_cell(5, "Regime / chart price", (cashRegime ? "RTH" : "OVERNIGHT") + " / " + str.tostring(close, format.mintick))
    f_cell(6, "Cash ATR20 / TR count", str.tostring(atr, "#.00") + " / " + str.tostring(atrCount))
    f_cell(7, "Position / stop", str.tostring(strategy.position_size) + " / " + (strategy.position_size != 0 ? str.tostring(activeStop, format.mintick) : "flat"))
    f_cell(8, "Net closed / open P&L", "$" + str.tostring(strategy.netprofit, "#.00") + " / $" + str.tostring(strategy.openprofit, "#.00"))
    f_cell(9, "Session net / budget", "$" + str.tostring(sessionNet, "#.00") + " / $" + str.tostring(lossBudget, "#.00"))
    f_cell(10, "Completed / win rate", str.tostring(strategy.closedtrades) + " / " + (strategy.closedtrades > 0 ? str.tostring(100.0 * strategy.wintrades / strategy.closedtrades, "#.0") + "%" : "—"))
    f_cell(11, "RTH size / clean outcomes", str.tostring(array.get(sizeQ, 0)) + " / " + str.tostring(array.get(sizeCount, 0)) + " / " + array.get(sizeReason, 0))
    f_cell(12, "Night size / clean outcomes", str.tostring(array.get(sizeQ, 1)) + " / " + str.tostring(array.get(sizeCount, 1)) + " / " + array.get(sizeReason, 1))
    f_cell(13, "Current long / short filter", str.tostring(longEfficiency, "#.00") + " / " + str.tostring(shortEfficiency, "#.00"))
    f_cell(14, "Costs / loss reviews", (feesVerified ? "User-verified" : "Provisional") + " / " + str.tostring(array.size(lossHeaders)) + " retained (max 20)")
    f_cell(15, "Calendar", "Oct 7–30, 2026; refresh before November")
    f_cell(16, "Model", "Closed-bar decisions; no tick/broker execution proof")
    f_cell(17, "Paper variant / planned cap", studyMode + " / " + (capEnabled ? "$" + str.tostring(tradeCap, "#.00") : "session budget only"))
    f_cell(18, "Risk rejections / open guard bars", str.tostring(riskRejects) + " / " + str.tostring(openGuardBars))
    f_cell(19, "Last completed / initial plan", lastAudit)
    table.clear(lossReview, 0, 0, 0, 11)
    if reviewVisible
        int lossIndex = array.size(lossHeaders) - reviewBack
        table.cell(lossReview, 0, 0, lossIndex >= 0 ? array.get(lossHeaders, lossIndex) : "No matching losses recorded", text_color = color.orange, text_size = size.small, text_halign = text.align_left)
        table.cell(lossReview, 0, 1, "30 diagnostic questions / page " + str.tostring(reviewPage) + " of 3 / change Inputs to select", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        if lossIndex >= 0
            for i = 0 to 9
                int offset = lossIndex * 30 + (reviewPage - 1) * 10 + i
                table.cell(lossReview, 0, i + 2, array.get(reviews, offset), text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
